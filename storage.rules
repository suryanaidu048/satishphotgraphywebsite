rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /gallery/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /hero/{allPaths=**} { allow read: if true; allow write: if isAdmin(); }
    match /{allPaths=**} { allow read: if isAdmin(); allow write: if isAdmin(); }
  }
}
