{
  "rules": {
    ".read": false,
    ".write": false,
    "homepageSections": { ".read": true, ".write": "auth != null" },
    "gallery": { ".read": true, ".write": "auth != null" },
    "pricingPlans": { ".read": true, ".write": "auth != null" },
    "testimonials": { ".read": true, ".write": "auth != null" },
    "services": { ".read": true, ".write": "auth != null" },
    "websiteSettings": { ".read": true, ".write": "auth != null" },
    "analytics": { ".read": "auth != null", ".write": "auth != null" },

    "bookings": {
      ".read": "auth != null",
      "$id": {
        ".write": "(auth != null) || !data.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'phone', 'message', 'status', 'createdAt'])",
        "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "email":     { ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 254" },
        "phone":     { ".validate": "newData.isString() && newData.val().length > 5 && newData.val().length <= 32" },
        "date":      { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 30)" },
        "eventType": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 100)" },
        "message":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
        "status":    { ".validate": "newData.isString() && newData.val().length > 0" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "$other":    { ".validate": "auth != null" }
      }
    },

    "messages": {
      ".read": "auth != null",
      "$id": {
        ".write": "(auth != null) || !data.exists()",
        ".validate": "newData.hasChildren(['name', 'email', 'phone', 'message', 'status', 'createdAt'])",
        "name":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
        "email":     { ".validate": "newData.isString() && newData.val().length > 3 && newData.val().length <= 254" },
        "phone":     { ".validate": "newData.isString() && newData.val().length > 5 && newData.val().length <= 32" },
        "message":   { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 4000" },
        "status":    { ".validate": "newData.isString() && newData.val().length > 0" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "!newData.exists() || newData.isNumber()" },
        "$other":    { ".validate": "auth != null" }
      }
    }
  }
}
